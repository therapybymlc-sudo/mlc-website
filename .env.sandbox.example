# Sandbox Environment Variables
# Use these to configure your sandbox environment on Render or locally.

APP_ENVIRONMENT=sandbox
DEBUG=True

# Backend
DJANGO_SECRET_KEY=your-sandbox-secret-key
ALLOWED_HOSTS=mlc-backend-sandbox.onrender.com,localhost
CORS_ALLOWED_ORIGINS=https://mlc-website-sandbox.onrender.com,http://localhost:5173

# Database (Ideally use a separate sandbox DB)
DATABASE_URL=postgres://user:pass@host:port/sandbox_db

# Razorpay (Use Test Keys)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

# Clerk (Sandbox/Development keys)
CLERK_ISSUER=https://...
CLERK_JWKS_URL=https://...
