# Clerk — set separately per Vercel environment (see below)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_********************************
CLERK_SECRET_KEY=sk_test_********************************
NEXT_PUBLIC_CLERK_JWT_TEMPLATE=backend

# PRODUCTION ONLY (Vercel → Production environment, mlchealth.in)
NEXT_PUBLIC_CLERK_DOMAIN=accounts.mlchealth.in
NEXT_PUBLIC_CLERK_IS_SATELLITE=true
NEXT_PUBLIC_CLERK_SIGN_IN_URL=https://mlchealth.in/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=https://mlchealth.in/signup

# Do NOT set on Preview:
# - NEXT_PUBLIC_CLERK_DOMAIN / IS_SATELLITE (causes CORS to accounts.mlchealth.in)
# - NEXT_PUBLIC_CLERK_PROXY_URL (breaks next build SSR)

# API base for Django backend
NEXT_PUBLIC_API_BASE=https://api.mlchealth.in/api
