# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_********************************
CLERK_SECRET_KEY=sk_live_********************************
NEXT_PUBLIC_CLERK_JWT_TEMPLATE=backend

# Production only (Vercel → Production environment)
# Hostname only — do NOT include https://
NEXT_PUBLIC_CLERK_DOMAIN=clerk.mlchealth.in
NEXT_PUBLIC_CLERK_IS_SATELLITE=true
NEXT_PUBLIC_CLERK_SIGN_IN_URL=https://mlchealth.in/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=https://mlchealth.in/signup

# API base for Django backend
NEXT_PUBLIC_API_BASE=https://api.mlchealth.in/api

# Therapist matching UI: manual (intake form) or auto (full quiz). Default manual.
NEXT_PUBLIC_THERAPIST_MATCHING_MODE=manual

# Subscription checkout — internal dashboard routes OR external Razorpay payment links (https://rzp.io/...)
NEXT_PUBLIC_THERAPIST_BASIC_MONTHLY_URL=/dashboard/therapist/subscription?plan=monthly
NEXT_PUBLIC_THERAPIST_BASIC_ANNUAL_URL=/dashboard/therapist/subscription?plan=annual
NEXT_PUBLIC_THERAPIST_PREMIUM_ANNUAL_URL=/dashboard/therapist/subscription?plan=premium
# Optional hosted payment links (override dashboard checkout when set):
# NEXT_PUBLIC_RAZORPAY_THERAPIST_BASIC_MONTHLY_LINK=
# NEXT_PUBLIC_RAZORPAY_THERAPIST_BASIC_ANNUAL_LINK=
# NEXT_PUBLIC_RAZORPAY_THERAPIST_PREMIUM_ANNUAL_LINK=
# NEXT_PUBLIC_RAZORPAY_CLIENT_PREMIUM_ANNUAL_LINK=
