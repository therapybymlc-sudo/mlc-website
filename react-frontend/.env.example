# Clerk (Next.js — required on Vercel for Production AND Preview)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_********************************
CLERK_SECRET_KEY=sk_test_********************************
NEXT_PUBLIC_CLERK_JWT_TEMPLATE=backend

# Custom Clerk domain — production only (accounts.mlchealth.in)
# Preview (*.vercel.app) uses same-origin /__clerk proxy instead — see src/proxy.js
NEXT_PUBLIC_CLERK_DOMAIN=accounts.mlchealth.in
NEXT_PUBLIC_CLERK_SIGN_IN_URL=https://mlchealth.in/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=https://mlchealth.in/signup
# Optional override; preview/local default to /__clerk via src/lib/clerk-config.js
# NEXT_PUBLIC_CLERK_PROXY_URL=/__clerk

# API base for Django backend
NEXT_PUBLIC_API_BASE=https://api.mlchealth.in/api
