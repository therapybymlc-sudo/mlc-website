# 🧩 DJANGO CORE SETTINGS
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# 🗄️ DATABASE SETTINGS (PostgreSQL)
# Leave empty to use DB_* Postgres settings below. For local dev without Postgres:
# DATABASE_URL=sqlite:////absolute/path/to/backend/db.sqlite3
DATABASE_URL=
DB_NAME=mlc_db
DB_USER=mlc_user
DB_PASSWORD=mlc_pass
DB_HOST=localhost
DB_PORT=5432

# 🌍 CORS / FRONTEND CONNECTIONS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\.vercel\.app$
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# 📹 JITSI / JAAS CONFIGURATION
JITSI_APP_ID=vpaas-magic-cookie-xxxxxxxx
JITSI_KID=vpaas-magic-cookie-xxxxxxxx/xxxxxx
JITSI_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----

# 💳 RAZORPAY CONFIGURATION
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
RAZORPAY_BASIC_MONTHLY_PLAN_ID=
RAZORPAY_BASIC_ANNUAL_PLAN_ID=
RAZORPAY_PREMIUM_ANNUAL_PLAN_ID=

# 🔐 CLERK AUTHENTICATION
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-app.clerk.accounts.dev

# 📧 EMAIL (report delivery)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=MLC Reports <noreply@mlc-therapy.local>
FRONTEND_URL=https://www.mlchealth.in

# 📧 RESEND EMAIL CONFIGURATION
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=MLC Health <therapy@mlchealth.in>

# 💬 Rocket.Chat (therapist-client messages)
ROCKET_CHAT_URL=
ROCKET_CHAT_ADMIN_USER_ID=
ROCKET_CHAT_ADMIN_AUTH_TOKEN=
ROCKET_CHAT_MANAGED_USER_PASSWORD=
ROCKET_CHAT_TIMEOUT_SECONDS=12

# 📁 File storage — production uses Cloudflare R2 (see below)
FILE_STORAGE_BACKEND=local
# FILE_STORAGE_BACKEND=r2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=mlc-health-media
# AWS_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=pub-xxxxxxxxxxxxxxxx.r2.dev
# AWS_S3_REGION_NAME=auto

# Set to true when Premium (Therapist OS / Lux Studio) is ready for checkout
PREMIUM_SUBSCRIPTION_ENABLED=false

# 🧩 Therapist matching — manual intake (default) vs auto-match quiz
THERAPIST_MATCHING_MODE=manual
THERAPIST_INTAKE_NOTIFY_EMAILS=therapybymlc@gmail.com,therapy@mlchealth.in,therapy.aditya@gmail.com
THERAPIST_INTAKE_NOTIFY_PHONE=+91 0000000000

# Recommended for intake alerts on Render (Brevo → SMTP & API → API Keys)
BREVO_API_KEY=
INTAKE_EMAIL_FROM=MLC Health <therapy@mlchealth.in>
