DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=*
# Leave empty to use DB_* Postgres settings below. For local dev without Postgres, e.g.:
# DATABASE_URL=sqlite:////absolute/path/to/backend/db.sqlite3
# SQLite migrations only affect that local file; production should use Postgres and run migrations there.
DATABASE_URL=
DB_NAME=mlc_db
DB_USER=mlc_user
DB_PASSWORD=mlc_pass
DB_HOST=localhost
DB_PORT=5432

# Email (report delivery)
# Local/dev default is console backend; for production set SMTP backend + creds.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=MLC Reports <noreply@mlc-therapy.local>
FRONTEND_URL=https://www.mlchealth.in

# Rocket.Chat (therapist-client messages)
ROCKET_CHAT_URL=
ROCKET_CHAT_ADMIN_USER_ID=
ROCKET_CHAT_ADMIN_AUTH_TOKEN=
ROCKET_CHAT_MANAGED_USER_PASSWORD=
ROCKET_CHAT_TIMEOUT_SECONDS=12

# Clerk JWT verification
CLERK_JWKS_URL=https://api.clerk.dev/v1/jwks
# Required in production so Django can resolve primary email when JWT omits it
CLERK_SECRET_KEY=
# Optional: set to your Clerk issuer, e.g. https://your-domain.clerk.accounts.dev
CLERK_ISSUER=

# File storage — production uses Cloudflare R2 (see below)
FILE_STORAGE_BACKEND=local

# Cloudflare R2 (recommended production: 10 GB free, zero egress fees)
# Bucket name suggestion: mlc-health-media
# FILE_STORAGE_BACKEND=r2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=mlc-health-media
# AWS_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=pub-xxxxxxxxxxxxxxxx.r2.dev
# AWS_S3_REGION_NAME=auto

# Cloudinary (optional alternative)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Frontend origins (both apex and www required — site loads from either)
CORS_ALLOWED_ORIGINS=https://mlchealth.in,https://www.mlchealth.in
CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\\.vercel\\.app$
CSRF_TRUSTED_ORIGINS=https://mlchealth.in,https://www.mlchealth.in

# Razorpay (server-side only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# Therapist matching — manual intake (default) vs auto-match quiz
# manual: public quiz saves enquiry + emails admin; full matcher only via admin route
# auto: restore instant therapist matching for everyone
THERAPIST_MATCHING_MODE=manual
THERAPIST_INTAKE_NOTIFY_EMAILS=therapybymlc@gmail.com,therapy@mlchealth.in
THERAPIST_INTAKE_NOTIFY_PHONE=+91 9741672947
